# ==============================================================================
# ENTERPRISE DETECTION RULESET
# ==============================================================================

# 1. Stealth Reconnaissance Tracking (Nmap FIN Scan)
alert tcp any any -> $HOME_NET any (msg:"CUSTOM THREAT - Stealth Nmap FIN Scan Detected"; flags:F; ack:0; threshold: type limit, track by_src, count 1, seconds 60; sid:1000006; rev:2;)

# 2. Web Application Enumeration (DirBuster)
alert http any any -> $HOME_NET any (msg:"CUSTOM THREAT - Malicious Web Enumeration Tool Detected"; http.user_agent; content:"DirBuster"; threshold: type limit, track by_src, count 1, seconds 60; sid:1000007; rev:2;)

# 3. Web Exploitation / Path Traversal
alert http any any -> $HOME_NET any (msg:"CUSTOM THREAT - Web Path Traversal Attempt"; content:".."; http_raw_uri; threshold: type limit, track by_src, count 1, seconds 60; sid:1000008; rev:3;)

# 4. Volumetric Denial of Service (TCP SYN Flood)
alert tcp any any -> $HOME_NET any (msg:"CUSTOM THREAT - High Velocity TCP SYN Flood"; flags:S; threshold: type both, track by_src, count 50, seconds 60; sid:1000009; rev:2;)

# 5. Initial Access Protection (RDP Brute Force)
alert tcp any any -> $HOME_NET 3389 (msg:"CUSTOM THREAT - RDP Brute Force Attempt"; flags:S; threshold: type both, track by_src, count 5, seconds 60; sid:1000010; rev:2;)
